# ============================================================
#  环境变量模板
# ------------------------------------------------------------
#  用法：把本文件复制一份、改名成 .env，然后填入你自己的 Key。
#       .env 已经被 .gitignore 忽略，不会被提交到 GitHub。
# ============================================================

# --- DeepSeek ------------------------------------------------
# 申请地址：https://platform.deepseek.com
# 在「API Keys」页面点创建，形如 sk-开头的一长串
# 注意：创建后只会完整显示一次，当场复制走
DEEPSEEK_API_KEY=

# --- 阿里云百炼 / 通义千问（备选，你已有阿里云账号）-------------
# 如果想零成本起步，可以改用这个：控制台通常给新用户免费额度
# 申请地址：https://bailian.console.aliyun.com
#
# ★ 留空的后果必须说清楚：向量检索会退回**词袋哈希兜底**（local-hash），
#   它只有词面匹配能力，**没有任何语义理解** ——
#   换个说法问同一件事就召不到了。
#   填好之后 /rag/stats 的 embedder_ready 会变成 true。
#   自检和评测都会如实报出当前用的是哪一档 ——
#   别把兜底当成真的语义检索（这是这个项目最容易高估自己的一项）。
DASHSCOPE_API_KEY=

# --- 默认使用哪个模型 ----------------------------------------
# 现在对外的主模型名是 deepseek-flash；deepseek-chat 是兼容别名，
# 实测请求 chat 时服务端返回的正是 flash。
# 成本按**服务端返回的**模型计费（两者单价不同，见 observability/costs.py）。
DEFAULT_MODEL=deepseek-chat

# --- 调试开关 ------------------------------------------------
# 1 = 打印完整的请求和返回内容（第一次调通时打开，很有用）
# 0 = 只打印结果
DEBUG=1

# ============================================================
#  告警自动化（Zabbix / Alertmanager → POST /webhook/alert）
# ============================================================
# ★ 默认只产出「处置预案」（一份写死的命令清单），**不会去查机器**。
#   要让它真去查，打开下面这个开关 —— 但请先读完这段：
#
#   开启后**每条告警都会跑一轮 Agent 诊断**（实测 6–20 秒、几分钱）。
#   "自动"是有价的：凌晨网络抖一下推 500 条告警 = 500 次诊断。
#   所以打开的同时必须带上两道闸（代码里已实现，这里只调参数）：
#     ① ALERT_DEDUP_SECONDS  同名 + 同机的告警，窗口内只处理一次
#     ② ALERT_MAX_PER_HOUR   每小时最多自动诊断几次，超了转人工
#   两道闸都挡在调模型**之前**，所以被抑制的告警不会偷偷烧钱。
ALERT_AUTO_DIAGNOSE=0
ALERT_DEDUP_SECONDS=600
ALERT_MAX_PER_HOUR=10

# ============================================================
# --- 日志与指标（M4）------------------------------------------
# ============================================================
# 日志格式：text（默认，人类可读，观感与改动前一致）/ json（一行一个 JSON）
LOG_FORMAT=text
# 日志级别：DEBUG / INFO（默认）/ WARNING / ERROR。写错会回退 INFO 并打一条警告。
LOG_LEVEL=INFO
# trace 与审计日志的轮转阈值（字节）与保留份数。
# ★ 只有 traces.jsonl 与 audit.jsonl 会轮转 ——
#   approvals/incidents 是折叠式状态日志，挪走一部分会静默丢状态，所以它们不轮转。
LOG_MAX_BYTES=10485760
LOG_KEEP=5
# 置 1 时 /healthz 会**真的调一次模型**（花钱）。默认只看 trace 痕迹，零成本。
HEALTHZ_PROBE_MODEL=0


# --- 告警聚合（一个故障，不是 50 个）---------------------------------
# ★ 1 = 按「主机 + 服务」聚合成一个事件：同机同服务的 50 条不同告警
#       只会跑**一次**诊断，其余 49 条作为成员并入同一个事件。
#       这是"告警风暴不烧钱"的关键：抑制发生在调模型之前。
#   0 = 退回旧语义：按「告警名 + 主机」精确去重，每条告警各自成一个事件。
#       行为与加这个开关之前完全一致，用于对比与回退。
# 注意：两种模式下"被抑制 ≠ 被丢弃" —— 被抑制的告警会记录它并入了哪个事件。
ALERT_AGGREGATE=1

# 去重/聚合表的最大条目数（防止长期运行内存单调增长）。
# 超限时先清过期条目，再淘汰最旧的。
ALERT_AGG_MAX_ENTRIES=5000

# --- 告警抑制（维护窗口）---------------------------------------------
# 计划内变更（磁盘扩容、发版、主从切换）本来就会触发一堆告警。
# 不抑制的话，Agent 会认真地为你自己的维护动作做诊断并推通知 ——
# 几次之后值班的人就开始无视通知了，那才是真正的事故。
#
# 规则文件默认 data/alert_silences.json，格式：
#   [{"alertname_prefix": "DiskSpace", "host_prefix": "db-01",
#     "until": "2026-10-03T02:00:00", "note": "磁盘扩容（CHG-2026-101）"}]
# 语义要点：
#   · 字段缺失 = 该维度不限制；显式给空串 "" 才等于匹配一切
#   · 忘了写 until（或解析不出来）→ **不抑制**（fail-open）
#     抑制是"少做一件事"，出错时宁可更吵；反过来会把真告警藏起来
#   · 改文件不必重启（按 mtime+size 懒加载）
#ALERT_SILENCE_FILE=

# --- 告警入口是否异步 ------------------------------------------------
# ★ 默认 0（同步）：与现有响应形态一致 —— 响应里直接带诊断结论。
#   1 = 立即返回 accepted，诊断在后台跑。Alertmanager 侧有超时约束，
#       告警量大时异步更稳；代价是"结论不在响应里"，要去 /incidents 查。
ALERT_ASYNC=0

# 写操作（重启 / 清理）永远转人工，与上面这些开关无关 ——
# 这是本项目的核心边界：宁可少做，不可做错。

# ============================================================
#  出站通知（把结论送到值班的人手上）
# ============================================================
# ★ 留空 = **完全不出站**，行为与没有这一节时一模一样。
#
#   为什么需要它：告警链路原来的终点是"响应体 + audit.jsonl" ——
#   凌晨三点没有任何人会被叫醒。诊断做得再对，送不到人手上就等于没做。
#
#   为什么默认关闭：通知会把内部信息发到外部 IM。打开了就意味着
#   你确认了这些内容可以出站 —— 所以默认关闭，由你显式打开。
#
# 渠道多选，逗号分隔：webhook,dingtalk,feishu
#NOTIFY_CHANNELS=
#
# 通用 webhook：POST JSON {"title","text","source","ts","extra"}
# 任何能收 HTTP 的系统都能接（自建告警中心、n8n、工单系统……）
#NOTIFY_WEBHOOK_URL=
#
# 钉钉自定义机器人（群设置 → 智能群助手 → 添加机器人 → 自定义）
# SECRET 是"加签"用的密钥；不用加签就留空（但公网机器人建议加签）
#NOTIFY_DINGTALK_URL=
#NOTIFY_DINGTALK_SECRET=
#
# 飞书 / Lark 自定义机器人
#NOTIFY_FEISHU_URL=
#NOTIFY_FEISHU_SECRET=
#
# 单个渠道的超时（秒）与最多重试次数。
# ★ 重试是必须的：IM 侧偶发 5xx/限流很常见，一次失败就丢等于经常丢。
#   通知是**旁路** —— 重试全部失败也不会影响诊断结果本身，只记审计。
#NOTIFY_TIMEOUT=8
#NOTIFY_MAX_ATTEMPTS=3
#
# 同一个事件在这么多秒内不重复推（防通知轰炸：一次风暴别刷 50 条群消息）
#NOTIFY_MIN_INTERVAL=60
#
# 1 = 出站内容脱敏（默认）。掩掉凭据、password=/token= 的值、长哈希串，
#     但保留主机名、服务名、路径、退出码这些真正有用的运维信息。
#     **不要关掉它**，除非你完全清楚出站内容里会出现什么。
#NOTIFY_MASK=1

# ============================================================
#  公网安全层
# ============================================================
# 本地开发保持 AUTH_ENABLED=0，行为与之前完全一致。
# 一旦要放到公网（别人能访问到这个地址），必须改成 1 ——
# 否则任何人扫到这个端口，就能刷你的模型额度、
# 甚至批准服务器上待执行的写操作。
AUTH_ENABLED=0

# 开启鉴权后**必须**填，否则服务会拒绝启动（fail-closed：
# 宁可起不来，也不要「以为有保护、其实裸奔」）。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 调用时放在请求头：X-API-Key: <token>
#            或：Authorization: Bearer <token>
AGENT_TOKEN=

# 单个 IP 每分钟最多多少次请求。
# 注意这是按 IP 分的，而 IP 取自 X-Forwarded-For —— 那个头客户端能伪造，
# 所以它只挡得住"手滑狂点"，挡不住有心人。
RATE_LIMIT_PER_MIN=20

# 全站每分钟上限。这一层跟客户端身份无关，伪造 IP 也绕不过去，
# 是真正防刷的那道闸。
RATE_LIMIT_GLOBAL_PER_MIN=60

# 每天最多多少次「花钱」调用（问模型、重建索引这类）。
# 前两层是速率限制，这一层是总量限制 —— 即使被慢慢刷，账单也有上限。
# 只统计真正调用模型/embedding 的接口，查日志、看健康状态不扣。
DAILY_QUOTA=300

# ============================================================
#  工具层数据源（Agent 的「手」到底在查哪里）
# ============================================================
# 决定 6 个只读工具（check_disk / check_load / check_service /
# list_containers / tail_log / search_knowledge）的数据从哪来。三选一：
#
#   mock   内置仿真数据，不连任何真实机器（默认）
#   local  在本机执行只读命令（df -h / systemctl / docker ps / tail）
#   ssh    通过 SSH 到真实远程主机执行只读命令
#
# ★ 默认 mock 是刻意的：别人 clone 下来什么都不用配就能跑通整条链路，
#   而且评测集的 40 条题依赖固定输出（要可复现）。
#
# ★ 切到真机时，「逻辑主机名」与「真实地址」是解耦的 ——
#   Agent 只认识 web-01 这样的逻辑名，它不知道、也不该知道那台机器在哪。
#   映射放在下面几行里，好处有两个：
#     1. 换机器只改配置，prompt / 评测集 / 文档一行都不用动
#     2. 模型无法「自己编一个 IP 去连」—— 它能选的只有清单里的名字
OPS_BACKEND=mock

# 已知主机清单（可选，逗号分隔）。不填时：
#   mock 后端 → web-01、db-01、cache-01（内置仿真主机）
#   ssh  后端 → 直接取 OPS_SSH_TARGETS 里配的名字（配置即清单）
# 例：OPS_HOSTS=web-01,db-01
#OPS_HOSTS=

# SSH 目标映射（OPS_BACKEND=ssh 时必填）。
# 格式：逻辑名=用户@地址[:端口]，多个用逗号分隔。
# 例（单机）：web-01=root@1.2.3.4
# 例（多机）：web-01=root@1.2.3.4, db-01=ops@10.0.0.9:2222
#OPS_SSH_TARGETS=

# 私钥路径。**请用专用密钥，不要复用你连 GitHub 或平时登录服务器的那把** ——
# 一把钥匙开一处门，泄了一把不用连着换另一处。
# 生成：ssh-keygen -t ed25519 -f ~/.ssh/agentdesk_ops -N ""
# 再把 ~/.ssh/agentdesk_ops.pub 的内容追加到目标机器的 ~/.ssh/authorized_keys
#OPS_SSH_KEY=

# 私钥在宿主机上的目录（只有用 docker compose 部署时才需要）。
# compose 用它做变量替换，把整个目录**只读**挂进容器的 /app/.ssh。
#   - 挂目录而不是单个文件：换密钥时不用动 compose
#   - 只读：容器跑的是别人能通过 HTTP 触发的代码，不能让它改写这把钥匙
#   - 容器内是非 root（uid 10001）运行，所以宿主机上这份私钥要让
#     uid 10001 可读：chown 10001:10001 <key> && chmod 600 <key
#OPS_KEY_DIR=./.ssh

# ------------------------------------------------------------
#  【特例】让容器 SSH 回**它自己所在这台宿主机**
# ------------------------------------------------------------
# 常见于「应用容器化部署在它要监控的那台机器上」——本项目线上实例就是这样。
# 这时容器内的 127.0.0.1 是它自己，看不到宿主机的真实磁盘/负载/容器，
# 必须 SSH 回 bridge 网络的网关（= 宿主机）：
#
#   OPS_SSH_TARGETS=web-01=root@<本容器所在 bridge 的网关>
#
# 网关地址用这条命令确认（不要凭记忆写，不同网络模式不一样）：
#   docker inspect <容器名> --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
#
# ★ 这种场景下**务必给密钥加限制** —— 它是一把能登 root 的钥匙，
#   却挂在一个公网可达的服务容器里。在 authorized_keys 那一行前面加：
#
#   from="<docker网段>",no-pty,no-agent-forwarding,no-port-forwarding,no-X11-forwarding,no-user-rc <公钥>
#
#   含义：只接受来自该网段的连接 + 禁用转发与终端分配。
#   效果：攻击者**必须先攻进容器**才能用这把钥匙 —— 从公网拿到它没用。
#   注意：容器用的是自定义 bridge 时，网段**不是** 172.17.0.0/16
#   （默认 bridge 才是那个）；本项目实测是 172.18.0.0/16。

# 默认登录用户。映射里写了 user@ 的以映射为准。
OPS_SSH_USER=root

# 单条命令超时 / 建连超时（秒）。
# ★ 分开设是有意的：混在一起会让「连不上」和「命令跑太久」报同一个错，
#   而这两件事的排查方向完全相反。
OPS_SSH_TIMEOUT=15
OPS_SSH_CONNECT_TIMEOUT=8

# 【ssh 后端下执行通道是关闭的，这是刻意的 fail-closed】
# 诊断走远端，但沙箱的执行通道目前只在本机落地。
# 「诊断在远端、执行在本地」这种错配，比「不能执行」危险得多 ——
# 打错的机器和打对的机器只差一个环境变量，不该靠"记得改"来避免。
# 所以 run_command 在 ssh 后端下会直接拒绝：不提交审批，也不执行。
# 确实需要在真机上做处置时，请在目标主机上以 OPS_BACKEND=local 运行。

# ============================================================
#  沙箱执行
# ============================================================
# 决定「写操作命令」在什么环境里执行。四选一：
#
#   auto        有 Docker 用 Docker，没有就用 mock（**不会**降级成无隔离执行）
#   docker      强制用一次性容器（真隔离）。探测不到会拒绝执行，不降级
#   subprocess  直接在目标主机执行（**无隔离**）。只有你明确知道后果时才开
#   mock        仿真执行，任何机器都能跑通演示与自检
#
# ★ 默认 auto，且 fail-closed：沙箱不可用时拒绝执行，而不是偷偷降级。
#
# 【公网部署建议用 mock】理由是攻击面：
#   docker 模式要挂 /var/run/docker.sock，等于把容器创建权限交出去 ——
#   而容器创建可以挂载宿主机根目录，一旦 token 泄露就是整机沦陷。
#   subprocess 模式会在容器里真执行命令，那条命令能读到容器内的 .env，
#   也就是你的 API Key。
#   本机演示「真隔离」时可以用 docker，公网长期开着建议 mock。
SANDBOX_BACKEND=auto

# 沙箱容器镜像。真隔离时用它跑命令（tail / truncate 这类文件操作）。
# 首次执行会自动拉取；也可以先手动 docker pull alpine:3.20
SANDBOX_IMAGE=alpine:3.20

# ============================================================
#  Langfuse 可观测面板（可选）
# ============================================================
# 三个都填了才会启用导出；不填就是纯本地记录模式（logs/traces.jsonl），功能不受影响。
#
# 方式一：Langfuse Cloud（免费额度，最省事）
#   1. 注册 https://cloud.langfuse.com
#   2. Settings → API Keys → Create new keys
#   3. HOST 填 https://cloud.langfuse.com
#
# 方式二：自托管（数据不出本机）
#   deploy/langfuse-compose.yml 起服务后，HOST 填 http://localhost:3000
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
