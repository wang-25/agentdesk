# ============================================================
#  环境变量模板
# ------------------------------------------------------------
#  用法：把本文件复制一份、改名成 .env，然后填入你自己的 Key。
#       .env 已经被 .gitignore 忽略，不会被提交到 GitHub。
# ============================================================

# --- DeepSeek（Day 0 就用它）---------------------------------
# 申请地址：https://platform.deepseek.com
# 在「API Keys」页面点创建，形如 sk-开头的一长串
# 注意：创建后只会完整显示一次，当场复制走
DEEPSEEK_API_KEY=

# --- 阿里云百炼 / 通义千问（备选，你已有阿里云账号）-------------
# 如果想让 Day 0 零成本，可以改用这个：控制台通常给新用户免费额度
# 申请地址：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# --- 默认使用哪个模型 ----------------------------------------
# deepseek-chat 是通用对话模型，便宜、够用
# 换模型时只改这一行，代码不用动
DEFAULT_MODEL=deepseek-chat

# --- 调试开关 ------------------------------------------------
# 1 = 打印完整的请求和返回内容（第一次调通时打开，很有用）
# 0 = 只打印结果
DEBUG=1

# ============================================================
#  公网安全层（Day 10 部署）
# ============================================================
# 本地开发保持 AUTH_ENABLED=0，行为与之前完全一致。
# 一旦要放到公网（别人能访问到这个地址），必须改成 1 ——
# 否则任何人扫到这个端口，就能刷你的模型额度、
# 甚至批准服务器上待执行的写操作。
AUTH_ENABLED=0

# 开启鉴权后**必须**填，否则服务会拒绝启动（fail-closed：
# 宁可起不来，也不要「以为有保护、其实裸奔」）。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 调用时放在请求头：X-API-Key: <token>
#            或：Authorization: Bearer <token>
AGENT_TOKEN=

# 单个 IP 每分钟最多多少次请求。
# 注意这是按 IP 分的，而 IP 取自 X-Forwarded-For —— 那个头客户端能伪造，
# 所以它只挡得住"手滑狂点"，挡不住有心人。
RATE_LIMIT_PER_MIN=20

# 全站每分钟上限。这一层跟客户端身份无关，伪造 IP 也绕不过去，
# 是真正防刷的那道闸。
RATE_LIMIT_GLOBAL_PER_MIN=60

# 每天最多多少次「花钱」调用（问模型、重建索引这类）。
# 前两层是速率限制，这一层是总量限制 —— 即使被慢慢刷，账单也有上限。
# 只统计真正调用模型/embedding 的接口，查日志、看健康状态不扣。
DAILY_QUOTA=300

# ============================================================
#  沙箱执行（Day 7）
# ============================================================
# 决定「写操作命令」在什么环境里执行。四选一：
#
#   auto        有 Docker 用 Docker，没有就用 mock（**不会**降级成无隔离执行）
#   docker      强制用一次性容器（真隔离）。探测不到会拒绝执行，不降级
#   subprocess  直接在目标主机执行（**无隔离**）。只有你明确知道后果时才开
#   mock        仿真执行，任何机器都能跑通演示与自检
#
# ★ 默认 auto，且 fail-closed：沙箱不可用时拒绝执行，而不是偷偷降级。
#
# 【公网部署建议用 mock】理由是攻击面：
#   docker 模式要挂 /var/run/docker.sock，等于把容器创建权限交出去 ——
#   而容器创建可以挂载宿主机根目录，一旦 token 泄露就是整机沦陷。
#   subprocess 模式会在容器里真执行命令，那条命令能读到容器内的 .env，
#   也就是你的 API Key。
#   本机演示「真隔离」时可以用 docker，公网长期开着建议 mock。
SANDBOX_BACKEND=auto

# 沙箱容器镜像。真隔离时用它跑命令（tail / truncate 这类文件操作）。
# 首次执行会自动拉取；也可以先手动 docker pull alpine:3.20
SANDBOX_IMAGE=alpine:3.20

# ============================================================
#  Langfuse 可观测面板（Day 8，可选）
# ============================================================
# 三个都填了才会启用导出；不填就是纯本地记录模式（logs/traces.jsonl），功能不受影响。
#
# 方式一：Langfuse Cloud（免费额度，最省事）
#   1. 注册 https://cloud.langfuse.com
#   2. Settings → API Keys → Create new keys
#   3. HOST 填 https://cloud.langfuse.com
#
# 方式二：自托管（数据不出本机）
#   deploy/langfuse-compose.yml 起服务后，HOST 填 http://localhost:3000
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
