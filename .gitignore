# ============================================================
#  密钥文件：绝对不能提交到 GitHub
# ============================================================
.env
*.key
secrets.json

# ============================================================
#  Python 运行时产物
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境：每个人自己建，不进仓库
.venv/
venv/
env/

# ============================================================
#  本地数据与运行产物
# ============================================================
# 注意：data/knowledge/ 是知识库语料，属于项目内容，必须提交。
#       只忽略构建出来的索引 —— 索引可以随时重建，没必要进仓库。
data/index/
logs/
*.log

# 评测产物分两类处理：
#   *.md   报告本身**要提交** —— 打开仓库就该看到真实数字，
#          这是整个项目最有说服力的资产之一。
#   *.json 逐条明细（含全部回答原文）体积大、属中间产物，不进仓库。
eval/reports/*.json

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# 练习脚本生成的产物（可随时重跑生成）
output/

# 测试用的临时 payload
_t*.json
_q.json

# 接口测试用的临时 payload
_*.json

# Langfuse 自托管的本地密钥
deploy/langfuse.env

# ============================================================
#  个人学习资料：属于本地笔记，不属于项目内容，不进仓库
# ============================================================
docs/knowledge-points.md
docs/python-reference.md
practice/

# ★ 这个仓库是**作品集**，不是学习档案。面试/备考材料一律不进仓库 ——
#   文件本身保留在 E:/Workbuddy/ai agent/个人备考笔记/，只是不发布。
#   加这几条的直接原因：曾有一批「面试准备」文档被放进仓库目录，
#   而 .gitignore 没覆盖，一条 `git add -A` 就会把它们一起推上公开仓库。
#   **"我没打算提交"和"提交不上去"是两件事，后者才是可靠的。**
面试/
INTERVIEW_*.md
TESTING_REPORT.md

# Langfuse 自托管的真实环境变量（含密钥，绝不进仓库）
deploy/langfuse/.env
