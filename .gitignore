# ============================================================
#  密钥文件：绝对不能提交到 GitHub
# ============================================================
.env
*.key
secrets.json

# ============================================================
#  Python 运行时产物
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境：每个人自己建，不进仓库
.venv/
venv/
env/

# ============================================================
#  本地数据与运行产物
# ============================================================
# 注意：data/knowledge/ 是知识库语料，属于项目内容，必须提交。
#       只忽略构建出来的索引 —— 索引可以随时重建，没必要进仓库。
data/index/
logs/
*.log

# 评测产物分两类处理：
#   *.md   报告本身**要提交** —— 打开仓库就该看到真实数字，
#          这是整个项目最有说服力的资产之一。
#   *.json 逐条明细（含全部回答原文）体积大、属中间产物，不进仓库。
eval/reports/*.json

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# 练习脚本生成的产物（可随时重跑生成）
output/

# 测试用的临时 payload
_t*.json
_q.json

# 接口测试用的临时 payload
_*.json

# Langfuse 自托管的本地密钥
deploy/langfuse.env

# ============================================================
#  个人学习资料：属于本地笔记，不属于项目内容，不进仓库
# ============================================================
docs/knowledge-points.md
docs/python-reference.md
practice/
