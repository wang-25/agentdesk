# ============================================================
#  Langfuse 自托管的环境变量
#  复制成 .env 后，**必须**替换掉所有 CHANGEME
# ============================================================
# 这是**本地观察用**的实例，只绑 127.0.0.1，不对外。
# 即便如此也别沿用下面的默认值 —— 它们是官方 compose 里的示例，人人都知道。

# ---- 三个密钥：自己生成，不要照抄 ----
#   Linux/Mac:  openssl rand -hex 32
#   Windows（没有 openssl 时用项目自带环境）：
#     .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGEME_32字节hex
NEXTAUTH_SECRET=CHANGEME_32字节hex
SALT=CHANGEME_32字节hex

# ---- 依赖组件的口令 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres
POSTGRES_VERSION=17

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME

REDIS_AUTH=CHANGEME

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

# ---- 其他 ----
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

# 端口冲突时改这里（本机 5432 / 6379 若已被别的程序占用）。
# 注意：改了端口，compose 里的 ports 映射要同步改。
